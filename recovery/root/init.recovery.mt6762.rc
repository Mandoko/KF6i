import /init.recovery.microtrust.rc

on init
    # Standardize /dev/block layout
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64/hw

    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1

on fs
    mkdir /mnt/vendor/persist 0771 root root
    mount ext4 /dev/block/platform/bootdevice/by-name/persist /mnt/vendor/persist
    
# Create /data/vendor in ramdisk and redirect /data/vendor/thh to /vendor/thh
    mkdir /data/vendor 0755 root root
    symlink /vendor/thh /data/vendor/thh

    # Ensure device nodes have root access in recovery
    chmod 0660 /dev/teei_client
    chown root root /dev/teei_client
    chmod 0660 /dev/teei_config
    chown root root /dev/teei_config
    chmod 0666 /dev/isee_tee0
    chown root root /dev/isee_tee0
    chmod 0660 /dev/tz_vfs
    chown root root /dev/tz_vfs
    chmod 0660 /dev/ut_keymaster
    chown root root /dev/ut_keymaster
    chmod 0660 /dev/rpmb0
    chown root root /dev/rpmb0

    install_keyring
    setprop crypto.ready 1

on post-fs
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
    start mtk.plpath.utils.link

on boot
    start vendor.boot-hal-1-1
    start health-hal-2-1

on fs && property:ro.debuggable=0
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

# ==============================================================================
# SERVICES
# ==============================================================================

service hwservicemanager /system/bin/hwservicemanager
    user root
    group root readproc
    disabled
    onrestart setprop hwservicemanager.ready false
    seclabel u:r:recovery:s0

service keystore_auth /system/bin/keystore_auth
    oneshot
    user system
    group root
    disabled
    seclabel u:r:recovery:s0

service keystore /system/bin/keystore /tmp/misc/keystore
    user root
    group root drmrpc readproc
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service vendor.keymaster-4-0-beanpod /vendor/bin/hw/android.hardware.keymaster@4.0-service.beanpod
    class early_hal
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

service vendor.boot-hal-1-1 /vendor/bin/hw/android.hardware.boot@1.1-service
    interface android.hardware.boot@1.0::IBootControl default
    interface android.hardware.boot@1.1::IBootControl default
    class early_hal
    user root
    group root
    seclabel u:r:recovery:s0

service health-hal-2-1 /vendor/bin/hw/android.hardware.health@2.1-service
    class hal charger
    user system
    group system
    capabilities WAKE_ALARM
    file /dev/kmsg w
    seclabel u:r:recovery:s0

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:recovery:s0

# ==============================================================================
# TRIGGERS
# ==============================================================================

on property:crypto.ready=1
    start hwservicemanager

on property:hwservicemanager.ready=true
    start vendor.keymaster-4-0-beanpod
    start vendor.gatekeeper-1-0

on property:vendor.sys.listener.registered=true
    start vendor.gatekeeper-1-0
    start vendor.keymaster-4-0-beanpod

on property:ro.crypto.state=unsupported
    stop teei_daemon
    stop vendor.keymaster-4-0-beanpod
    stop vendor.gatekeeper-1-0

on property:ro.crypto.state=unencrypted
    stop teei_daemon
    stop vendor.keymaster-4-0-beanpod
    stop vendor.gatekeeper-1-0

on property:twrp.decrypt.done=true
    stop teei_daemon
    stop vendor.keymaster-4-0-beanpod
    stop vendor.gatekeeper-1-0

# ============================================
# CUSTOM DECRYPTION SETUP
# ============================================

on post-fs
    # Set library paths (AFTER device symlinks are created)
    export LD_LIBRARY_PATH /system_root/system/lib64:/vendor/lib64:/system_root/system/lib:/vendor/lib:/system_root/vendor/lib64:/system_root/vendor/lib:/system_ext/lib64:/system_ext/lib:/product/lib64:/product/lib:/vendor/lib64/hw:/vendor/lib/hw:/system_root/vendor/lib64/hw:/system_root/vendor/lib/hw
    
    # Set Android root
    export ANDROID_ROOT /system_root/system
    export ANDROID_DATA /data
    
    # Linker configuration
    mkdir /linkerconfig 0755 root root
    copy /system_root/system/etc/ld.config.txt /linkerconfig/ld.config.txt
    chmod 444 /linkerconfig/ld.config.txt
    export LD_CONFIG_FILE /linkerconfig/ld.config.txt

on post-fs-data
    # Start essential services for decryption
    start logd
    start servicemanager
    start hwservicemanager
    start vndservicemanager
    start vold
    start keystore
    start gatekeeper

# ============================================
# CUSTOM DECRYPTION TRIGGERS
# ============================================

on property:vold.decrypt=trigger_post_fs_data
    trigger post-fs-data

on property:vold.decrypt=trigger_restart_framework
    setprop sys.recovery.decrypted 1
    setprop vold.decrypt=decryption_done

# ============================================
# SERVICES
# ============================================

service vold /system_root/system/bin/vold
    class core
    critical
    seclabel u:r:vold:s0
    shutdown critical

service servicemanager /system_root/system/bin/servicemanager
    class core
    critical
    seclabel u:r:servicemanager:s0

service hwservicemanager /system_root/system/bin/hwservicemanager
    class core
    critical
    seclabel u:r:hwservicemanager:s0

service vndservicemanager /system_root/system/bin/vndservicemanager
    class core
    critical
    seclabel u:r:vndservicemanager:s0

service logd /system_root/system/bin/logd
    class core
    critical
    seclabel u:r:logd:s0

service keystore /system_root/system/bin/keystore
    class main
    user keystore
    group keystore
    seclabel u:r:keystore:s0

service gatekeeper /system_root/system/bin/gatekeeperd
    class main
    user system
    group system
    seclabel u:r:gatekeeperd:s0


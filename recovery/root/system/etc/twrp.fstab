# twrp.fstab - TWRP Partition Configuration with Backup Support
# ============================================
# SYSTEM PARTITIONS
# ============================================

# Mount system partitions for decryption
/system_root     /system_root     ext4     ro,barrier=1     wait,avb=vbmeta_system,logical,slotselect     twrp=display="System";mounttodecrypt
/vendor          /vendor          ext4     ro,barrier=1     wait,avb,logical,slotselect                    twrp=display="Vendor";mounttodecrypt
/system_ext      /system_ext      ext4     ro,barrier=1     wait,avb,logical,slotselect                    twrp=display="System Ext";mounttodecrypt
/product         /product         ext4     ro,barrier=1     wait,avb,logical,slotselect                    twrp=display="Product";mounttodecrypt

# ============================================
# SUPER PARTITION (Logical Volume for Backup)
# ============================================

/super           /super           emmc     defaults         defaults     twrp=display="Super";backup=1;flashimg=1;wipeingui

# ============================================
# INDIVIDUAL SYSTEM IMAGES (For Backup)
# ============================================

/system_image    /system_image    emmc     defaults         defaults     twrp=display="System Image";backup=1;flashimg=1;wipeingui;slotselect
/vendor_image    /vendor_image    emmc     defaults         defaults     twrp=display="Vendor Image";backup=1;flashimg=1;wipeingui;slotselect
/system_ext_image /system_ext_image emmc  defaults         defaults     twrp=display="System_ext Image";backup=1;flashimg=1;wipeingui;slotselect
/product_image   /product_image   emmc     defaults         defaults     twrp=display="Product Image";backup=1;flashimg=1;wipeingui;slotselect

# ============================================
# METADATA (Encryption Keys)
# ============================================

/metadata        /metadata        ext4     noatime,nosuid,nodev,discard     wait,check,formattable     twrp=display="Metadata";backup=1

# ============================================
# DATA (Encrypted - FBE)
# ============================================

/data            /data            f2fs     noatime,nosuid,nodev,discard,noflush_merge,reserve_root=134217,resgid=1065,inlinecrypt,tran_gc     wait,check,quota,reservedsize=128M,formattable,resize     twrp=display="Data";fileencryption=aes-256-xts:aes-256-cts:v2;keydirectory=/metadata/vold/metadata_encryption;mounttodecrypt

# ============================================
# OTHER PARTITIONS (With Backup Flag)
# ============================================

/boot            /boot            emmc     defaults     defaults,slotselect     twrp=display="Boot";backup=1
/dtbo            /dtbo            emmc     defaults     defaults                    twrp=display="DTBO";backup=1
/vbmeta          /vbmeta          emmc     defaults     defaults                    twrp=display="VBMeta";backup=1
/vbmeta_vendor   /vbmeta_vendor   emmc     defaults     defaults,slotselect         twrp=display="VBMeta Vendor";backup=1
/vbmeta_system   /vbmeta_system   emmc     defaults     defaults,slotselect         twrp=display="VBMeta System";backup=1

# ============================================
# EXTERNAL STORAGE
# ============================================

/sdcard          /sdcard          auto     defaults     defaults     twrp=display="SD Card";storage;removable;voldmanaged=sdcard1:auto
/usbotg          /usbotg          vfat     defaults     defaults     twrp=display="USB OTG";storage;removable;voldmanaged=usbotg:auto
